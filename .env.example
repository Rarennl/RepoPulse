# The app starts with empty credentials, showing a truthful empty state.
PUBLIC_ORIGIN=http://localhost:8000
SOURCECRAFT_TOKEN=
SOURCECRAFT_ORGS=sourcecraft
# all = DiscoverRepositories; organizations = explicit SOURCECRAFT_ORGS only.
DISCOVERY_MODE=all
APPSEC_ENABLED=true
# Optional separate public-collection credential. Empty = use SOURCECRAFT_TOKEN.
# Confirm the auth scheme with the Security API owner (OpenAPI does not specify it).
APPSEC_TOKEN=
APPSEC_AUTH_SCHEME=Bearer
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Optional: Fernet.generate_key(); same key for API and workers. Backup securely.
TOKEN_ENCRYPTION_KEY=
# Change before hosting outside localhost.
POSTGRES_PASSWORD=local-dev-only
